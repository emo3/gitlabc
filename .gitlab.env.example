# Machine-local GitLab endpoint configuration.
# Copy this file to .gitlab.env and set the host's stable LAN address.
GITLAB_DOMAIN=192.168.86.50.nip.io
GITLAB_EXTERNAL_IP=192.168.86.50
GITLAB_SSH_HOST=gitlab.192.168.86.50.nip.io

# Primary/standby handoff. Run promote on either host to make it active.
GITLAB_PRIMARY_HOST=almalinxo
GITLAB_STANDBY_HOST=almalt
GITLAB_PRIMARY_SSH=192.168.86.80
GITLAB_STANDBY_SSH=192.168.86.141
